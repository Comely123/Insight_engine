# Optional LLM. Leave empty for rules-only unless user enables LLM in UI.
# Never commit real keys.
# Default self-hosted OpenAI-compatible endpoint:
# INSIGHT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# INSIGHT_LLM_MODEL=qwen2.5:7b
# INSIGHT_LLM_LOCAL_KEY=local
# Optional cloud key (or enter in public UI session only):
# OpenAI:
# INSIGHT_LLM_API_KEY=sk-...
# INSIGHT_LLM_BASE_URL=https://api.openai.com/v1
# INSIGHT_LLM_MODEL=gpt-4o-mini
# DeepSeek:
# INSIGHT_LLM_API_KEY=sk-...
# INSIGHT_LLM_BASE_URL=https://api.deepseek.com/v1
# INSIGHT_LLM_MODEL=deepseek-chat

# Phase 3 media (optional) — quick setup:
#   .\scripts\setup_media.ps1
#   python scripts\check_media_deps.py
# Models cache: data/models/faster-whisper (project-local, gitignored)
# INSIGHT_ASR_ENABLED=1
# INSIGHT_ASR_MODEL=tiny
# INSIGHT_OCR_ENABLED=1

# Platform collectors (scaffolds only — official/authorized tokens when available)
